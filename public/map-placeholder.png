<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="70%">
      <stop offset="0%" stop-color="#101014"/>
      <stop offset="100%" stop-color="#050507"/>
    </radialGradient>
    <linearGradient id="stroke" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.12"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="800" height="800" fill="url(#bg)"/>

  <!-- subtle border ring -->
  <circle cx="400" cy="400" r="360" fill="none" stroke="url(#stroke)" stroke-width="2"/>

  <!-- map icon -->
  <g transform="translate(250 250)" fill="none" stroke="#ffffff" stroke-opacity="0.85" stroke-width="18" stroke-linejoin="round" stroke-linecap="round">
    <path d="M20 90 L140 40 L260 90 L260 330 L140 380 L20 330 Z"/>
    <path d="M140 40 L140 380"/>
    <path d="M20 90 L20 330"/>
    <path d="M260 90 L260 330"/>
  </g>

  <!-- text -->
  <text x="400" y="620" text-anchor="middle" font-family="system-ui, -apple-system, Segoe UI, Roboto, sans-serif" font-size="28" fill="#e5e7eb" fill-opacity="0.92">
    Navigazione disponibile solo all'interno del parco
  </text>
</svg>

